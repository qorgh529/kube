        <mxCell id="etcd" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;클러스터 상태 저장소&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#E6FCF5;strokeColor=#0CA678;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
