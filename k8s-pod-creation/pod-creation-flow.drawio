        <mxCell id="kubeconfig" value="~/.kube/config&lt;br&gt;(서버 주소·인증서)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF9DB;strokeColor=#FAB005;fontSize=10;" vertex="1" parent="1">
