        <mxCell id="yaml" value="&lt;div style='text-align:left;font-family:monospace;font-size:11px'&gt;# nginx-deploy.yaml&lt;br&gt;apiVersion: apps/v1&lt;br&gt;kind: Deployment&lt;br&gt;metadata:&lt;br&gt;&amp;nbsp;&amp;nbsp;name: nginx&lt;br&gt;spec:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b style='color:#E03131'&gt;replicas: 6&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;template:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;spec:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;containers:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;- image: nginx&lt;/div&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CED4DA;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
