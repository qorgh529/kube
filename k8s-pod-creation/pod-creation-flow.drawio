        <mxCell id="kubectl" value="&lt;b&gt;kubectl&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;apply -f nginx-deploy.yaml&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E7F5FF;strokeColor=#1C7ED6;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
