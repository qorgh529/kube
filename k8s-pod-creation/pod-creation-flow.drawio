        <mxCell id="apiserver" value="&lt;b style='font-size:16px'&gt;kube-apiserver&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;AuthN → AuthZ(RBAC) → Admission → Validation&lt;br&gt;모든 통신의 유일한 관문 (REST + watch)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBE4FF;strokeColor=#3B5BDB;fontSize=13;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="370" width="330" height="110" as="geometry" />
